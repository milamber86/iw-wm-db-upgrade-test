---
# Copy to inventory/iwupgrade/group_vars/all/vault.yml, fill in, then encrypt:
#
#   cp inventory/iwupgrade/.vault.yml.example \
#      inventory/iwupgrade/group_vars/all/vault.yml
#   $EDITOR inventory/iwupgrade/group_vars/all/vault.yml
#   ansible-vault encrypt inventory/iwupgrade/group_vars/all/vault.yml
#
# Run with: ansible-playbook -i inventory/iwupgrade playbooks/iw-upgrade-site.yml --ask-vault-pass
#
# Every key below has a non-secret default in group_vars/all/main.yml, so the
# playbook can start without a vault file; fill the vault before a real run.

# --- guest cloud-init / SSH -------------------------------------------------
# Non-root user created by cloud-init (must match an account you can log in as).
vault_vm_cloud_user: root
# Optional cloud-init password (used when the template is not a cloud-init image
# and you must fall back to a documented existing login).
vault_vm_cloud_password: ""
vault_vm_ssh_keys:
  - "ssh-ed25519 AAAA... replace-me@host"
# Control-node private key used to reach the guest.
vault_vm_ssh_key_file: ""

# --- MySQL ------------------------------------------------------------------
vault_mysql_root_password: change-me-root
vault_mysql_iw_password: change-me-iwdb

# --- production backup host -------------------------------------------------
# The real (not-yet-production) server that holds the bck_db_*.sql.gz dumps,
# e.g. icewarp.onice.io. Log in as the human operator account with the existing
# key; do NOT use root. Root is reached the way real production hosts expect:
# the account may only run a few commands passwordless, e.g.
#   (ALL : ALL) NOPASSWD: /bin/su, /usr/bin/sudo, /bin/bash
# so `sudo su -` works but arbitrary `sudo <cmd>` does not. The inventory sets
# ansible_shell_executable: /bin/bash for this host so the delegated firewall
# tasks elevate through that allow-list.
vault_prod_ssh_host: icewarp.onice.io
vault_prod_ssh_user: beranek
# Either a control-node key path (used both to reach prod and, staged, to let
# the guest pull the dumps)...
vault_prod_ssh_private_key_file: ~/.ssh/id_ecdsa
# ...or inline key material.
vault_prod_ssh_private_key: ""
# Directory that holds the `bck_db_*.sql.gz` dumps (defaults to /mnt/data/backup).
vault_prod_backup_dir: /mnt/data/backup

# --- probed test cloud server (roles/iw_dbprobe) ----------------------------
# The read-only database/backup probe (playbooks/iw-db-probe.yml) reaches the
# test cloud server directly as root; override the control-node key path here.
vault_onice_ssh_private_key_file: ~/.ssh/id_ecdsa
