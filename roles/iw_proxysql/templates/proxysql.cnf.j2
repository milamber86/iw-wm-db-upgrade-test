# ProxySQL {{ proxysql_version }} — IceWarp upgrade test bed (generated by roles/iw_proxysql).
#
# Imported into ProxySQL's SQLite store on the first start only (when
# {{ proxysql_datadir }}/proxysql.db does not exist). Later runs reconcile the
# same servers/users/variables through the admin interface.
datadir="{{ proxysql_datadir }}"
errorlog="{{ proxysql_datadir }}/proxysql.log"

admin_variables=
{
    admin_credentials="{{ proxysql_admin_user }}:{{ proxysql_admin_password }}"
    mysql_ifaces="{{ proxysql_admin_host }}:{{ proxysql_admin_port }}"
    refresh_interval=2000
    web_enabled=false
}

mysql_variables=
{
    threads={{ proxysql_threads }}
    max_connections={{ proxysql_max_connections }}
    interfaces="{{ proxysql_mysql_bind }}:{{ proxysql_mysql_port }}"
    default_schema="information_schema"
    server_version="{{ proxysql_server_version }}"
    have_compress=true
    poll_timeout=2000
    stacksize=1048576
    connect_timeout_server=3000
    connect_retries_on_failure=10
    monitor_username="{{ proxysql_monitor_user }}"
    monitor_password="{{ proxysql_monitor_password }}"
    monitor_connect_interval=20000
    monitor_ping_interval=10000
    monitor_read_only_interval=1500
    monitor_read_only_timeout=500
    init_connect="{{ proxysql_init_connect }}"
    ping_interval_server_msec=120000
    ping_timeout_server=500
    commands_stats=true
    sessions_sort=true
    wait_timeout=28800000
    max_allowed_packet={{ proxysql_max_allowed_packet }}
}

mysql_servers =
(
    {
        address="{{ mysql_host }}"
        port={{ mysql_port }}
        hostgroup={{ proxysql_hostgroup_writer }}
        weight=1
        max_connections={{ proxysql_max_connections }}
        comment="Percona 8.0 backend"
    }
)

mysql_users =
(
    {
        username="{{ mysql_iw_user }}"
        password="{{ mysql_iw_password }}"
        default_hostgroup={{ proxysql_hostgroup_writer }}
        default_schema="information_schema"
        active=1
        max_connections={{ proxysql_max_connections }}
    }
)

mysql_query_rules =
(
)
